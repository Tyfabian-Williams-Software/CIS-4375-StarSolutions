# Copy this file to .env and fill secrets locally (do NOT commit .env with real secrets)

FLASK_ENV=production
PORT=8000
SECRET_KEY=replace-me-with-a-secure-random-value
# DATABASE_URL should be an SQLAlchemy-style URL. Example (MySQL / PyMySQL):
# mysql+pymysql://user:password@db-host:3306/restaurant
DATABASE_URL=
WORKER_CLASS=eventlet
GUNICORN_WORKERS=2
